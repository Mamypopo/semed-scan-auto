# ==========================================
# SEMed Scanner - Environment Configuration
# ==========================================

# API Configuration
# URL ของเซิร์ฟเวอร์หลัก (ตัวอย่าง: https://api.hospital.com)
API_BASE_URL=https://api.hospital.com

# Default Station ID (ถ้าไม่ได้ตั้งค่าใน UI)
DEFAULT_STATION_ID=STATION_001

# Scanner Configuration
# ความเร็วในการสแกน (ms) - ถ้าพิมพ์ช้ากว่านี้จะถือว่าเป็นคนพิมพ์
SCAN_THRESHOLD_MS=50

# Notification Configuration
# เปิด/ปิดเสียงแจ้งเตือน (true/false)
ENABLE_SOUND=true

# App Configuration
# โหมดการทำงาน (development/production)
NODE_ENV=development

# เปิด/ปิด DevTools (true/false)
OPEN_DEVTOOLS=false
