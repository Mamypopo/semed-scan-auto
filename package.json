{
  "name": "semed-scanner",
  "version": "1.0.0",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "dev:renderer": "cd src/renderer && npm run dev",
    "dev:electron": "set NODE_ENV=development&& electron . --dev",
    "build": "cd src/renderer && npm run build && cd ../.. && electron-builder",
    "build:win": "npm run build -- --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "dotenv": "^16.4.5",
    "electron-store": "^11.0.2",
    "koffi": "^2.16.2",
    "node-notifier": "^10.0.1"
  },
  "build": {
    "appId": "com.hospital.semed-scanner",
    "productName": "SEMed Scanner",
    "asar": false,
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "out/renderer/**/*",
      "assets/**/*",
      ".env",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!node_modules/.bin/**/*",
      "!node_modules/**/README*",
      "!node_modules/**/test/**/*",
      "!node_modules/**/tests/**/*",
      "!node_modules/**/*.md"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SEMed Scanner"
    }
  }
}
