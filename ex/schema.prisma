  patientCNGroupId String?
  patientCNGroup   CNGroupMembership? @relation("MuscleExaminationCNGroup", fields: [patientCNGroupId], references: [id], onDelete: SetNull)

  // สำหรับ Clinic
  patientMembershipId String?
  patientMembership   PatientMembership? @relation("MuscleExaminationPatientMembership", fields: [patientMembershipId], references: [id], onDelete: SetNull)

