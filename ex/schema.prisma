  examinationNumber Int // ครั้งที่ตรวจ (auto-increment ต่อผู้ป่วย)

  // Foreign Key ไปยัง Patient และ Membership
  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

