  isDeleted Boolean @default(false)

  // Relations
  createdByUser User? @relation("MuscleExaminationCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("MuscleExaminationUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([cn, patientCNGroupId, examinationNumber])
  @@unique([hn, patientMembershipId, examinationNumber])
  @@index([patientId])
  @@index([patientCNGroupId])
  @@index([patientMembershipId])
  @@index([cn])
  @@index([hn])
  @@index([equipmentId])
  @@index([createdBy])
  @@index([createdAt])
  @@index([isDeleted])
}

// หมายเหตุการตรวจกล้ามเนื้อ (สำหรับ CRUD)
model MuscleExaminationSpecify {
