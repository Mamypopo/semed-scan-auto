model Registration {
  id                  String           @id @default(cuid())
  patientId           Int
  type                RegistrationType
  patientCNGroupId    String?
  patientMembershipId String?
  registeredAt        DateTime?
  vnNumber            String?
  insurance_type_id   Int?
  branchId            Int? // สำหรับ checkup registration ไม่เกี่ยวกับสาขา
  createdBy           Int?
  updatedBy           Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @default(now())
  note                String?
  isCancelled         Boolean          @default(false)
  cancelledAt         DateTime?
  cancelledBy         Int?

  // Relations
  createdByUser       User?                @relation("RegistrationCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser       User?                @relation("RegistrationUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  patient             Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientCNGroup      CNGroupMembership?   @relation(fields: [patientCNGroupId], references: [id], onDelete: SetNull)
  patientMembership   PatientMembership?   @relation(fields: [patientMembershipId], references: [id], onDelete: SetNull)
  insuranceType       InsuranceType?       @relation(fields: [insurance_type_id], references: [id], onDelete: SetNull)
  branch              Branch?              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cancelledByUser     User?                @relation("RegistrationCancelledBy", fields: [cancelledBy], references: [id], onDelete: SetNull)
  scanItems           ScanItem[]
  referralsFrom       Referral[]           @relation("ReferralFromRegistration")
  payments            Payment[] // 1 Registration สามารถมีหลาย Payment (สำหรับ payment history)
  labExaminations     LabExamination[]
  medicalCertificates MedicalCertificate[]

  @@index([type])
  @@index([patientCNGroupId])
  @@index([patientId])
  @@index([isCancelled])
  @@index([branchId, type])
  @@index([patientCNGroupId, type])
  @@index([patientId, createdAt])
  @@index([branchId, createdAt])
  @@index([insurance_type_id])
  // Composite indexes สำหรับ checkup registration performance
  @@index([patientId, patientCNGroupId, type, isCancelled])
  @@index([patientId, type, isCancelled, createdAt])
  @@index([createdBy])
  @@index([updatedBy])
}

// Payment model - สำหรับเก็บข้อมูลการชำระเงิน (ยืดหยุ่นสำหรับระบบการเงินในอนาคต)
model Payment {
  id                  String        @id @default(cuid())
  registrationId      String? // Foreign key to Registration (optional — Checkup ไม่มี registration)
  patientCNGroupId    String? // FK → CNGroupMembership (Checkup special items)
  patientMembershipId String? // FK → PatientMembership (เผื่ออนาคต)
  status              String // 'PAID', 'PENDING', 'CANCELLED', 'VOIDED'
  amount              Decimal?      @db.Decimal(10, 2) // จำนวนเงินที่ชำระ
  totalAmount         Decimal?      @db.Decimal(10, 2) // จำนวนเงินรวมทั้งหมด (ก่อนส่วนลด)
  totalDiscount       Decimal?      @db.Decimal(10, 2) // ส่วนลดรวมทั้งหมด
  discountType        DiscountType? // 'AMOUNT' หรือ 'PERCENTAGE' สำหรับส่วนลดรวม
  finalAmount         Decimal?      @db.Decimal(10, 2) // จำนวนเงินสุดท้าย (หลังหักส่วนลด)

  // Payment Details
  paymentMethod  String? // 'TRANSFER' | 'CREDIT' | 'HDMALL'
  slipUrl        String? // URL สลิปการโอนเงิน (เก็บบน Blob)
  slipUploadedAt DateTime? // วันที่อัปโหลดสลิป
  receiptNumber  String? // เลขที่ใบเสร็จ
  paidAt         DateTime? // วันที่ชำระเงิน

  // Notes
  note String? // หมายเหตุ

  // Audit
  createdBy Int? // Foreign key to User (Int)
  updatedBy Int? // Foreign key to User (Int)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Relations
  registration      Registration?      @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  patientCNGroup    CNGroupMembership? @relation(fields: [patientCNGroupId], references: [id], onDelete: SetNull)
  patientMembership PatientMembership? @relation(fields: [patientMembershipId], references: [id], onDelete: SetNull)
  createdByUser     User?              @relation("PaymentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser     User?              @relation("PaymentUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  paymentItems      PaymentItem[]

  @@index([registrationId])
  @@index([patientCNGroupId])
  @@index([patientMembershipId])
  @@index([status])
  @@index([paidAt])
  @@index([createdAt])
  @@index([registrationId, status])
  @@index([patientCNGroupId, status])
}

model PaymentItem {
