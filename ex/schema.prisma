  // Foreign Key ไปยัง Patient และ Membership
  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // สำหรับ Checkup
  patientCNGroupId String?
  patientCNGroup   CNGroupMembership? @relation("LungExaminationCNGroup", fields: [patientCNGroupId], references: [id], onDelete: SetNull)

  // สำหรับ Clinic
