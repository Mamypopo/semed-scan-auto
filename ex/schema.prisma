model ParameterTemplate {
  id             Int      @id @default(autoincrement())
  name           String
  unit           String?
  description    String?
  valueType      String?
  decimalPlaces  Int      @default(0)
  options        Json?
  examTypeId     Int?
  examSubTypeId  Int?
  isActive       Boolean  @default(true)
  isIso15189     Boolean  @default(false) // พารามิเตอร์นี้ผ่านมาตรฐาน ISO 15189 (แสดง * เฉพาะเมื่อ MedicalItem ไม่ได้ mark)
  deltaLimit     Float?   @default(10.0) // % การเปลี่ยนแปลงที่จะแสดง Delta Check Badge (default 10%)
  note           String? // หมายเหตุเริ่มต้น — ใช้ pre-fill ResultItem.note ในหน้าลงผล lab
  detailTriggers Json? // ["Found","Positive"] — ค่า enum ที่เมื่อเลือกแล้วให้แสดงช่องรายงานเพิ่มเติม
  warnValues     Json? // ["Negative","AB"] — ค่าที่หายากหรือผิดปกติ ให้ highlight เตือนใน UI (ยังบันทึกได้)
  sumGroup       String? // ชื่อกลุ่มที่ต้องรวมกันได้ 100 เช่น "DC" สำหรับ Differential Count
  createdBy      Int?
  updatedBy      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())

  // Relations
  createdByUser                       User?                                @relation("ParameterTemplateCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser                       User?                                @relation("ParameterTemplateUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  examType                            ExamType?                            @relation(fields: [examTypeId], references: [id], onDelete: SetNull)
  examSubType                         ExamSubType?                         @relation(fields: [examSubTypeId], references: [id], onDelete: SetNull)
  patientExaminationParameterMappings PatientExaminationParameterMapping[]
  medicalItemParameterMappings        MedicalItemParameterMapping[]        @relation("ParameterMedicalItemMapping")
  referenceRanges                     ParameterReferenceRange[]            @relation("TemplateReferenceRanges")
  resultItems                         ResultItem[]                         @relation("ResultItemParameterTemplate")

  @@index([examTypeId])
  @@index([examSubTypeId])
  @@index([isActive])
  @@index([createdBy])
  @@index([updatedBy])
}

model ParameterReferenceRange {
  id                  Int               @id @default(autoincrement())
  parameterTemplateId Int
  template            ParameterTemplate @relation("TemplateReferenceRanges", fields: [parameterTemplateId], references: [id], onDelete: Cascade)

  // เงื่อนไขการคัดเลือก
  sex         String? // 'M' | 'F' | 'ALL'
  ageMinYears Int? // อายุขั้นต่ำ (ปี)
  ageMaxYears Int? // อายุสูงสุด (ปี)
  method      String? // มาตรฐานอ้างอิง (เช่น NGSP)

  // สำหรับเชิงปริมาณ
  low            Float?
  high           Float?
  inclusiveLow   Boolean? @default(true)
  inclusiveHigh  Boolean? @default(true)
  criticalLow    Float?
  criticalHigh   Float?
  borderlineLow  Float? // ค่าเริ่มต้นช่วงมีความเสี่ยง (เช่น 100)
  borderlineHigh Float? // ค่าสิ้นสุดช่วงมีความเสี่ยง (เช่น 125)

  // ขอบเขตค่าที่เป็นไปได้ทางสรีระวิทยา (Physiologically possible range)
  minValid Float? // ค่าต่ำสุดที่เป็นไปได้ (ต่ำกว่านี้ = ผิดปกติมาก/อาจผิดพลาด)
  maxValid Float? // ค่าสูงสุดที่เป็นไปได้ (สูงกว่านี้ = ผิดปกติมาก/อาจผิดพลาด)

  // สำหรับเชิงคุณภาพ (เลือก/ข้อความ)
  expectedValue String? // ค่าที่คาดหวังเดียว (ถ้าใช้)
  normalValues  Json? // รายการค่าปกติ เช่น ["negative", "ไม่พบ"]

  // Interpretation messages — flexible range-based lookup
  rangeInterpretations Json? // [{ "min": number|null, "max": number|null, "text": string }]

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parameterTemplateId])
  @@index([sex])
  @@index([method])
}

