  medicalItemName          String // snapshot ชื่อรายการตรวจ ณ เวลาซื้อ
  price                    Decimal  @db.Decimal(10, 2)
  quantity                 Int      @default(1)
  createdAt                DateTime @default(now())

  payment                Payment                @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  patientExaminationItem PatientExaminationItem @relation(fields: [patientExaminationItemId], references: [id])

  @@index([paymentId])
  @@index([patientExaminationItemId])
}

model ReceiptSequence {
  id        String @id @default(cuid())
  cnGroupId String @unique
  current   Int    @default(0)

  cnGroup CNGroup @relation(fields: [cnGroupId], references: [id])
}

model PatientExaminationItem {
  id                        String                     @id @default(uuid())
  patientId                 Int
  medicalItemId             String
  type                      PatientExaminationItemType
  parentPackageId           Int?
  patientPackageSelectionId String?
  patientCNGroupId          String?
  patientMembershipId       String?
  labExaminationId          String?
  value                     String?
  quantity                  Int                        @default(1)
  price                     Decimal?                   @db.Decimal(10, 2)
  discount                  Decimal                    @default(0) @db.Decimal(10, 2)
  discountType              DiscountType               @default(AMOUNT)
  status                    ExamItemStatus             @default(ACTIVE)
  cancelledAt               DateTime?
  cancelledBy               Int?
  createdBy                 Int?
  updatedBy                 Int?
  branchId                  Int?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @default(now())

  // Relations
  patient                             Patient                              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicalItem                         MedicalItem                          @relation(fields: [medicalItemId], references: [id], onDelete: Restrict)
  parentPackage                       Package?                             @relation(fields: [parentPackageId], references: [id], onDelete: SetNull)
  patientPackageSelection             PatientPackageSelection?             @relation(fields: [patientPackageSelectionId], references: [id], onDelete: SetNull)
  patientCNGroup                      CNGroupMembership?                   @relation(fields: [patientCNGroupId], references: [id], onDelete: SetNull)
  patientMembership                   PatientMembership?                   @relation(fields: [patientMembershipId], references: [id], onDelete: SetNull)
  labExamination                      LabExamination?                      @relation(fields: [labExaminationId], references: [id], onDelete: SetNull)
  branch                              Branch?                              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdByUser                       User?                                @relation("PatientExaminationItemCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser                       User?                                @relation("PatientExaminationItemUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  cancelledByUser                     User?                                @relation("PatientExaminationItemCancelledBy", fields: [cancelledBy], references: [id], onDelete: SetNull)
  patientExaminationParameterMappings PatientExaminationParameterMapping[]
  examinationResult                   ExaminationResult?
  referrals                           Referral[]
  paymentItems                        PaymentItem[]

  @@index([patientId])
  @@index([medicalItemId])
  @@index([patientCNGroupId])
  @@index([patientMembershipId])
  @@index([labExaminationId])
  @@index([type])
  @@index([status])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([createdAt])
  @@index([patientPackageSelectionId])
  @@index([patientId, patientCNGroupId])
  @@index([patientCNGroupId, type])
  @@index([patientMembershipId, type])
  @@index([patientId, createdAt])
  @@index([patientId, medicalItemId, patientCNGroupId, status])
  @@index([patientId, medicalItemId, patientMembershipId, status])
}

model PatientPackageSelection {
