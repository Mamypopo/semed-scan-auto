// ==========================================
// Prisma Schema: merged_hospital_system
// Complete version with all relations and indexes
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum PackageType {
  CLINIC
  CHECKUP
}

enum LabExaminationStatus {
  WAITING
  LAB_DONE
  APPROVED
}

enum RegistrationType {
  CHECKUP
  CLINIC
}

enum VisitType {
  CHECKUP
  CLINIC
}

enum DiscountType {
  AMOUNT
  PERCENTAGE
}

enum ScanType {
  SCAN
  EXCEL
  BULK
  EXAMINATION
}

enum ExaminationItemType {
  REGULAR
  SPECIAL
}

// ==========================================
// WORKFLOW TRACKING ENUMS
// ==========================================

enum CnGroupTaskStatus {
  TODO
  IN_PROGRESS
  COMPLETE
}

enum PatientExaminationItemType {
  CLINIC
  CHECKUP
  SPECIAL
}

enum ExamItemStatus {
  ACTIVE
  CANCELLED
}

enum ResultStatus {
  IN_PROGRESS
  COMPLETED
}

/// สถานะผลตรวจต่อพารามิเตอร์ (รวม entry + approval เป็นสถานะเดียว)
enum ResultItemStatus {
  PENDING // 1. รอลงผล (ช่องว่างเปล่า)
  DRAFT // 2. บันทึกร่าง (กรอกแล้วแต่ยังไม่ส่งอนุมัติ)
  PENDING_APPROVAL // 3. รออนุมัติ (พนักงานกดยืนยันส่งให้หัวหน้าตรวจ)
  RETURNED // 4. ส่งกลับให้แก้ (หัวหน้าตีกลับ หรือ ขอแก้ไขหลังอนุมัติ)
  APPROVED // 5. อนุมัติแล้ว (จบกระบวนการปกติ)
}

enum ReferralStatus {
  PENDING // รอส่งตัว
  IN_PROGRESS // กำลังส่งตัว
  COMPLETED // ส่งตัวเสร็จแล้ว
  CANCELLED // ยกเลิก
}

enum CNGroupSource {
  MANUAL // สร้างเองผ่านระบบ
  CRM_API // สร้างจาก CRM API
}

enum MedicalItemSource {
  MANUAL // สร้างเองผ่านระบบ
  CRM_API // สร้างจาก CRM API
}

enum CompanySource {
  MANUAL // สร้างเองผ่านระบบ
  CRM_API // สร้างจาก CRM API
}

// ==========================================
// MODELS (Tables)
// ==========================================

model User {
  id               Int     @id @default(autoincrement())
  name             String
  signatureName    String? // ชื่อที่ใช้แสดงบนรายงาน/ลายเซ็น (snapshot-friendly)
  signatureNameEn  String? // ชื่อลงนามภาษาอังกฤษ
  nickname         String? // ชื่อเล่น
  email            String  @unique
  password         String?
  microsoftId      String? @unique
  microsoftEmail   String? @unique
  roleId           Int? // RBAC: FK to Role
  defaultCNGroupId String?
  isGlobalPartTime Boolean @default(false)

  // Multi-Branch & System Access Control
  canAccessCheckup Boolean @default(true) // เข้าถึงระบบ Checkup ได้หรือไม่
  canAccessClinic  Boolean @default(true) // เข้าถึงระบบ Clinic ได้หรือไม่
  allowedCompanies Json?   @default("[]") // CUSTOMER: บริษัทที่ดูได้ ([] = ทุกบริษัท)

  profileImage     String?
  medicalLicenseNo String? // เลขใบอนุญาตประกอบวิชาชีพเวชกรรม (ว.XXXXX)
  doctorPosition   String? // ตำแหน่งหน้าที่ เช่น แพทย์ประจำ, นายแพทย์

  isActive     Boolean   @default(true)
  expiredAt    DateTime? // วันหมดอายุ (สำหรับ PARTTIME และ CUSTOMER)
  lastLoginAt  DateTime? // เวลาใช้งานล่าสุด
  createdBy Int?
  updatedBy Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())

  // Relations
  roleRef                            Role?                       @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdByUser                      User?                       @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser                      User?                       @relation("UserUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  usersCreated                       User[]                      @relation("UserCreatedBy")
  usersUpdated                       User[]                      @relation("UserUpdatedBy")
  insuranceTypesCreated              InsuranceType[]             @relation("InsuranceTypeCreatedBy")
  insuranceTypesUpdated              InsuranceType[]             @relation("InsuranceTypeUpdatedBy")
  patientGroupsCreated               PatientGroup[]              @relation("PatientGroupCreatedBy")
  patientGroupsUpdated               PatientGroup[]              @relation("PatientGroupUpdatedBy")
  tagsCreated                        Tag[]                       @relation("TagCreatedBy")
  tagsUpdated                        Tag[]                       @relation("TagUpdatedBy")
  patientsCreated                    Patient[]                   @relation("PatientCreatedBy")
  patientsUpdated                    Patient[]                   @relation("PatientUpdatedBy")
  companiesCreated                   Company[]                   @relation("CompanyCreatedBy")
  companiesUpdated                   Company[]                   @relation("CompanyUpdatedBy")
  cnGroupsCreated                    CNGroup[]                   @relation("CNGroupCreatedBy")
  cnGroupsUpdated                    CNGroup[]                   @relation("CNGroupUpdatedBy")
  cnGroupMembershipsCreated          CNGroupMembership[]         @relation("CNGroupMembershipCreatedBy")
  cnGroupExpectedItemsCreated        CNGroupExpectedItem[]       @relation("CNGroupExpectedItemCreatedBy")
  stationsCreated                    Station[]                   @relation("StationCreatedBy")
  stationsUpdated                    Station[]                   @relation("StationUpdatedBy")
  stationToMedicalItemsCreated       StationToMedicalItem[]      @relation("StationToMedicalItemCreatedBy")
  packagesCreated                    Package[]                   @relation("PackageCreatedBy")
  packagesUpdated                    Package[]                   @relation("PackageUpdatedBy")
  patientExaminationItemsCreated     PatientExaminationItem[]    @relation("PatientExaminationItemCreatedBy")
  patientExaminationItemsUpdated     PatientExaminationItem[]    @relation("PatientExaminationItemUpdatedBy")
  patientExaminationItemsCancelled   PatientExaminationItem[]    @relation("PatientExaminationItemCancelledBy")
  oldHealthRecordsCreated            OldHealthRecord[]           @relation("OldHealthRecordCreatedBy")
  healthRecordsCreated               HealthRecord[]              @relation("HealthRecordCreatedBy")
  documentJobTypesCreated            DocumentJobType[]           @relation("DocumentJobTypeCreatedBy")
  documentJobTypesUpdated            DocumentJobType[]           @relation("DocumentJobTypeUpdatedBy")
  documentJobsCreated                DocumentJob[]               @relation("DocumentJobCreatedBy")
  documentJobsUpdated                DocumentJob[]               @relation("DocumentJobUpdatedBy")
  documentJobMembershipsAdded        DocumentJobMembership[]     @relation("DocumentJobMembershipAddedBy")
  healthRecordsUpdated               HealthRecord[]              @relation("HealthRecordUpdatedBy")
  healthRecordsDocBy                 HealthRecord[]              @relation("HealthRecordDocBy")
  earExaminationsCreated             EarExamination[]            @relation("EarExaminationCreatedBy")
  earExaminationsUpdated             EarExamination[]            @relation("EarExaminationUpdatedBy")
  earCommentSpecifiesCreated         EarCommentSpecify[]         @relation("EarCommentSpecifyCreatedBy")
  diseaseAccidentEarSpecifiesCreated DiseaseAccidentEarSpecify[] @relation("DiseaseAccidentEarSpecifyCreatedBy")
  drugEarSpecifiesCreated            DrugEarSpecify[]            @relation("DrugEarSpecifyCreatedBy")
  congenitalDiseasesCreated          CongenitalDisease[]         @relation("CongenitalDiseaseCreatedBy")
  drugUsagesCreated                  DrugUsage[]                 @relation("DrugUsageCreatedBy")
  presentIllnessesCreated            PresentIllness[]            @relation("PresentIllnessCreatedBy")
  eyeExaminationsCreated             EyeExamination[]            @relation("EyeExaminationCreatedBy")
  eyeExaminationsUpdated             EyeExamination[]            @relation("EyeExaminationUpdatedBy")
  muscleExaminationsCreated          MuscleExamination[]         @relation("MuscleExaminationCreatedBy")
  muscleExaminationsUpdated          MuscleExamination[]         @relation("MuscleExaminationUpdatedBy")
  muscleExaminationSpecifiesCreated  MuscleExaminationSpecify[]  @relation("MuscleExaminationSpecifyCreatedBy")
  lungExaminationsCreated            LungExamination[]           @relation("LungExaminationCreatedBy")
  lungExaminationsUpdated            LungExamination[]           @relation("LungExaminationUpdatedBy")
  bmdExaminationsCreated             BmdExamination[]            @relation("BmdExaminationCreatedBy")
  bmdExaminationsUpdated             BmdExamination[]            @relation("BmdExaminationUpdatedBy")
  equipmentCreated                   Equipment[]                 @relation("EquipmentCreatedBy")
  equipmentUpdated                   Equipment[]                 @relation("EquipmentUpdatedBy")
  equipmentToStationsCreated         EquipmentToStation[]        @relation("EquipmentToStationCreatedBy")
  equipmentToStationsUpdated         EquipmentToStation[]        @relation("EquipmentToStationUpdatedBy")
  remarkReasonsCreated               RemarkReason[]              @relation("RemarkReasonCreatedBy")
  stationRemarksCreated              StationRemark[]             @relation("StationRemarkCreatedBy")
  systemLogs                         SystemLog[]                 @relation("SystemLogUser")
  scanItemsScanned                   ScanItem[]                  @relation("ScanItemScannedBy")
  scanItemsCancelled                 ScanItem[]                  @relation("ScanItemCancelledBy")
  scanItemLogs                       ScanItemLog[]               @relation("ScanItemLogUser")
  patientMembershipsCreated          PatientMembership[]         @relation("PatientMembershipCreatedBy")
  registrationsCancelled             Registration[]              @relation("RegistrationCancelledBy")
  registrationsCreated               Registration[]              @relation("RegistrationCreatedBy")
  registrationsUpdated               Registration[]              @relation("RegistrationUpdatedBy")
  departmentsCreated                 Department[]                @relation("DepartmentCreatedBy")
  departmentsUpdated                 Department[]                @relation("DepartmentUpdatedBy")
  medicalItemsCreated                MedicalItem[]               @relation("MedicalItemCreatedBy")
  medicalItemsUpdated                MedicalItem[]               @relation("MedicalItemUpdatedBy")
  parameterTemplatesCreated          ParameterTemplate[]         @relation("ParameterTemplateCreatedBy")
  parameterTemplatesUpdated          ParameterTemplate[]         @relation("ParameterTemplateUpdatedBy")
  examTypesCreated                   ExamType[]                  @relation("ExamTypeCreatedBy")
  examTypesUpdated                   ExamType[]                  @relation("ExamTypeUpdatedBy")
  examSubTypesCreated                ExamSubType[]               @relation("ExamSubTypeCreatedBy")
  examSubTypesUpdated                ExamSubType[]               @relation("ExamSubTypeUpdatedBy")
  itemCategoriesCreated              ItemCategory[]              @relation("ItemCategoryCreatedBy")
  itemCategoriesUpdated              ItemCategory[]              @relation("ItemCategoryUpdatedBy")
  medicalAuditLogs                   MedicalAuditLog[]           @relation("MedicalAuditLogUser")
  customerRatings                    CustomerRating[]            @relation("CustomerRatingUser")
  // Workflow Tracking Relations
  taskTemplatesCreated               TaskTemplate[]              @relation("TaskTemplateCreatedBy")
  taskTemplatesUpdated               TaskTemplate[]              @relation("TaskTemplateUpdatedBy")
  cnGroupTasksCreated                CnGroupTask[]               @relation("CnGroupTaskCreatedBy")
  cnGroupTasksUpdated                CnGroupTask[]               @relation("CnGroupTaskUpdatedBy")
  referralsIssued                    Referral[]                  @relation("ReferralIssuedBy")
  referralsReceived                  Referral[]                  @relation("ReferralReceivedBy")
  patientLogsChanged                 PatientLog[]                @relation("PatientLogChangedBy")
  paymentsCreated                    Payment[]                   @relation("PaymentCreatedBy")
  paymentsUpdated                    Payment[]                   @relation("PaymentUpdatedBy")
  labExaminationsLabBy               LabExamination[]            @relation("LabExaminationLabBy")
  labExaminationsApproved            LabExamination[]            @relation("LabExaminationApprovedBy")
  labExaminationsReceived            LabExamination[]            @relation("LabExaminationReceivedBy")
  labExaminationAuditLogs            LabExaminationAuditLog[]    @relation("LabExaminationAuditUser")
  labReportVersions                  LabReportVersion[]          @relation("LabReportVersionCreatedBy")
  resultItemsRecorded                ResultItem[]                @relation("ResultItemRecordedBy")
  resultItemsSubmitted               ResultItem[]                @relation("ResultItemSubmittedBy")
  resultItemsApproved                ResultItem[]                @relation("ResultItemApprovedBy")
  resultItemEditLogs                 ResultItemEditLog[]         @relation("ResultItemEditLogUser")
  peQcResultsBy                      PeQcResult[]                @relation("PeQcResultQcBy")
  patientPackageSelectionsCreated    PatientPackageSelection[]   @relation("PatientPackageSelectionCreatedBy")
  medCertsIssued                     MedicalCertificate[]        @relation("MedCertIssuedBy")
  defaultDoctorForBranches           Branch[]                    @relation("BranchDefaultDoctor")

  @@index([roleId])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([defaultCNGroupId])
  @@index([isGlobalPartTime])
}

model Branch {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  name          String
  nameEn        String?
  email         String?
  licenseNumber String?
  address       String?
  addressEn     String?
  phone         String?
  website       String?
  logo          String?
  isActive        Boolean  @default(true)
  isMainBranch    Boolean  @default(false)
  defaultDoctorId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  // Relations
  defaultDoctor User? @relation("BranchDefaultDoctor", fields: [defaultDoctorId], references: [id], onDelete: SetNull)
  systemLogs                    SystemLog[]
  registrations                 Registration[]
  patientExaminationItems       PatientExaminationItem[]
  healthRecords                 HealthRecord[]
  medicalAuditLogs              MedicalAuditLog[]
  examinationResults            ExaminationResult[]
  medicalItemsRequiringReferral MedicalItem[]             @relation("MedicalItemReferralBranch")
  referralsFrom                 Referral[]                @relation("ReferralFromBranch")
  referralsTo                   Referral[]                @relation("ReferralToBranch")
  patientPackageSelections      PatientPackageSelection[]
  packageBranches               PackageBranch[]
  medicalCertificates           MedicalCertificate[]
}

model Department {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  createdBy Int?
  updatedBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Relations
  createdByUser User? @relation("DepartmentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("DepartmentUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([createdBy])
  @@index([updatedBy])
}

model InsuranceType {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  note      String?
  isActive  Boolean  @default(true)
  createdBy Int?
  updatedBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Relations
  createdByUser User?          @relation("InsuranceTypeCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?          @relation("InsuranceTypeUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  registrations Registration[]

  @@index([isActive])
  @@index([createdBy])
  @@index([updatedBy])
}

model PatientGroup {
  id              Int      @id @default(autoincrement())
  name            String
  note            String?
  color           String?
  discount_type   String?
  discount_amount Decimal? @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  createdBy       Int?
  updatedBy       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  // Relations
  createdByUser User?     @relation("PatientGroupCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?     @relation("PatientGroupUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  patients      Patient[]

  @@index([isActive])
  @@index([createdBy])
  @@index([updatedBy])
}

model ContactPerson {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String?
  relationship String?
  patient_id   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  // Relations
  patient Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)
}

model File {
  id           Int      @id @default(autoincrement())
  url          String
  name         String?
  originalName String?
  fileSize     Int?
  description  String?
  uploadedBy   String?
  patient_id   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  // Relations
  patient Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  @@index([patient_id])
  @@index([createdAt])
  @@index([patient_id, createdAt])
  @@index([uploadedBy])
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     String?
  note      String?
  isActive  Boolean  @default(true)
  createdBy Int?
  updatedBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Relations
  createdByUser User?        @relation("TagCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?        @relation("TagUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  patientTags   PatientTag[]

  @@index([isActive])
  @@index([createdBy])
  @@index([updatedBy])
}

model PatientTag {
  id         Int @id @default(autoincrement())
  patient_id Int
  tag_id     Int

  // Relations
  patient Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@unique([patient_id, tag_id])
}

model Icd10 {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  groupCode   String?
  nameTh      String?
  nameEn      String?
  groupNameTh String?
  groupNameEn String?
  categoryId  Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  // Relations
  category ItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([groupCode])
  @@index([categoryId])
  @@index([isActive])
}

// VisitDiagnosis and VisitLog models removed - data moved to HealthRecord

model SystemLog {
  id        Int      @id @default(autoincrement())
  action    String
  details   Json?
  userId    Int?
  branchId  Int?
  hn        String?
  createdAt DateTime @default(now())

  // Relations
  user   User?   @relation("SystemLogUser", fields: [userId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)]) // โหลดหน้าแรก / กรองวันที่
  @@index([branchId, createdAt(sort: Desc)]) // กรองตามสาขา
  @@index([userId, createdAt(sort: Desc)]) // กรองตามพนักงาน
  @@index([action, createdAt(sort: Desc)]) // กรองตามประเภท Action
  @@index([hn, createdAt(sort: Desc)]) // กรองตาม HN คนไข้
}

model HNCount {
  id        Int      @id @default(autoincrement())
  year      Int
  current   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([year])
  @@index([year])
}

model VNSequence {
  id       Int    @id @default(autoincrement())
  branchId Int
  date     String // format: YYYY-MM-DD
  current  Int    @default(1)

  @@unique([branchId, date])
  @@index([branchId])
  @@index([date])
}

model ItemCodeCounter {
  id        Int      @id @default(autoincrement())
  current   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Company {
  id          String        @id @default(cuid())
  name        String
  code        String?       @unique // รหัสลูกค้าจาก CRM
  taxId       String?
  phone       String?
  email       String?
  address     String?
  subdistrict String?
  district    String?
  province    String?
  postalCode  String?
  isActive    Boolean       @default(true)
  note        String?
  source      CompanySource @default(MANUAL) // แหล่งที่มาของ Company (MANUAL = สร้างเอง, CRM_API = จาก CRM API)
  createdBy   Int?
  updatedBy   Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now())

  // Relations
  createdByUser User?     @relation("CompanyCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?     @relation("CompanyUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  cnGroups      CNGroup[]

  @@index([name])
  @@index([code])
  @@index([taxId])
  @@index([isActive])
  @@index([source])
  @@index([createdBy])
  @@index([updatedBy])
}

model CNGroup {
  id                             String        @id @default(cuid())
  name                           String
  code                           String?
  companyId                      String?
  isActive                       Boolean       @default(true)
  note                           String?
  includeQRCode                  Boolean       @default(true)
  peNote                         String?
  progressLink                   String?
  stationActiveCounts            Json? // จำนวนจุดตรวจที่ใช้งานจริง (key: stationId, value: จำนวนจุด) เช่น {"1": 3, "5": 2}
  source                         CNGroupSource @default(MANUAL) // แหล่งที่มาของ CNGroup (MANUAL = สร้างเอง, CRM_API = จาก CRM API)
  comparisonDiffThresholdPercent Int? // เปอร์เซ็นต์ผลต่างที่ใช้ในการเปรียบเทียบ (default 5% ที่ frontend)

  // ==========================================
  // WORKFLOW TRACKING FIELDS (New)
  // ==========================================
  useWorkflow      Boolean   @default(false) // เปิดใช้งาน Workflow Tracking หรือไม่
  projectStartDate DateTime? // วันที่เริ่มงาน (ถ้ากำหนด จะใช้เป็นวันเริ่มคำนวณ dueDate แทนการถอยจาก targetEndDate)
  targetEndDate    DateTime? // Deadline ใหญ่: วันที่กำหนดจบงานภาพรวม
  actualEndDate    DateTime? // วันที่งานทุกอย่างเสร็จจริง (อัปเดตอัตโนมัติเมื่อ Task สุดท้าย COMPLETE)
  taskTemplateId   String? // Task Template ที่ใช้สำหรับสร้าง Tasks

  createdBy Int?
  updatedBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Relations
  company         Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdByUser   User?                 @relation("CNGroupCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser   User?                 @relation("CNGroupUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  memberships     CNGroupMembership[]
  documentJobs    DocumentJob[]         @relation("DocumentJobToCNGroup")
  expectedItems   CNGroupExpectedItem[]
  tasks           CnGroupTask[] // Tasks สำหรับ Workflow Tracking
  taskTemplate    TaskTemplate?         @relation("CNGroupTaskTemplate", fields: [taskTemplateId], references: [id], onDelete: SetNull)
  receiptSequence ReceiptSequence?

  @@index([isActive])
  @@index([code])
  @@index([companyId])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([companyId, isActive])
  @@index([source])
  @@index([taskTemplateId])
}

model CNGroupMembership {
  id             String   @id @default(cuid())
  patientId      Int
  cnGroupId      String
  cn             String
  employeeCode   String?
  position       String?
  department     String?
  section        String?
  division       String?
  program        String?
  note           String?
  stickerNote    String?
  remark         String?
  passcode       String?
  companyName    String?
  companyPhone   String?
  companyEmail   String?
  companyAddress String?
  createdBy      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())

  // Relations
  patient                  Patient                   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  cnGroup                  CNGroup                   @relation(fields: [cnGroupId], references: [id], onDelete: Restrict)
  createdByUser            User?                     @relation("CNGroupMembershipCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  registrations            Registration[]
  patientExaminationItems  PatientExaminationItem[]
  healthRecords            HealthRecord[]
  oldHealthRecords         OldHealthRecord[]
  stationRemarks           StationRemark[]
  earExaminations          EarExamination[]          @relation("EarExaminationCNGroup")
  eyeExaminations          EyeExamination[]          @relation("EyeExaminationCNGroup")
  muscleExaminations       MuscleExamination[]       @relation("MuscleExaminationCNGroup")
  lungExaminations         LungExamination[]         @relation("LungExaminationCNGroup")
  bmdExaminations          BmdExamination[]          @relation("BmdExaminationCNGroup")
  documentJobMemberships   DocumentJobMembership[]
  patientPackageSelections PatientPackageSelection[]
  payments                 Payment[]

  @@unique([cnGroupId, cn])
  @@unique([patientId, cnGroupId])
  @@index([patientId])
  @@index([cnGroupId])
  @@index([cn])
  @@index([employeeCode])
  @@index([passcode])
  @@index([cnGroupId, companyName])
  @@index([companyName])
  @@index([cnGroupId, companyAddress])
  @@index([companyAddress])
}

model PatientMembership {
  id             String   @id @default(cuid())
  patientId      Int
  companyName    String?
  employeeCode   String?
  position       String?
  department     String?
  section        String?
