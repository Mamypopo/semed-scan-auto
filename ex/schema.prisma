  stationRemarks StationRemark[]

  @@index([isActive])
  @@index([isDefault])
  @@index([createdBy])
}

model StationRemark {
  id                  String   @id @default(uuid())
  patientCNGroupId    String? // Optional: สำหรับ Checkup scan
  patientMembershipId String? // Optional: สำหรับ Clinic scan
  stationId           Int
  reasonId            String?
  remark              String?
  createdBy           Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now())

  // Relations
  patientCNGroup    CNGroupMembership? @relation(fields: [patientCNGroupId], references: [id], onDelete: Cascade)
  patientMembership PatientMembership? @relation(fields: [patientMembershipId], references: [id], onDelete: Cascade)
  station           Station            @relation(fields: [stationId], references: [id], onDelete: Cascade)
  reason            RemarkReason?      @relation(fields: [reasonId], references: [id], onDelete: SetNull)
  createdByUser     User?              @relation("StationRemarkCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

