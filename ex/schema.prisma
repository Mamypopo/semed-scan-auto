model HealthRecord {
  id                  String  @id
  patientId           Int
  patientCNGroupId    String?
  patientMembershipId String? // สำหรับ Clinic

  // Vitals (จาก Visit)
  weight               String?
  height               String?
  bmi                  String?
  bsa                  String? // มีใน frontend แต่ไม่ได้บันทึกใน backend
  temperatureC         String? // มีใน frontend แต่ไม่ได้บันทึกใน backend
  bpReadings           Json? // Array of BP readings: [{ sys, dia, pulseRate, timestamp, measuredBy }, ...], selectedIndex
  // Legacy fields (deprecated - ใช้ bpReadings แทน)
  bpSys                String? // @deprecated - ใช้ bpReadings แทน
  bpDia                String? // @deprecated - ใช้ bpReadings แทน
  pulseRate            String? // @deprecated - ใช้ bpReadings แทน
  respiratoryRate      String? // มีใน frontend แต่ไม่ได้บันทึกใน backend
  o2Sat                String? // มีใน frontend แต่ไม่ได้บันทึกใน backend
  crt                  String? // มีใน frontend แต่ไม่ได้บันทึกใน backend
  headCircumferenceCm  String? // มีใน frontend แต่ไม่ได้บันทึกใน backend
  chestCircumferenceCm String? // มีใน frontend แต่ไม่ได้บันทึกใน backend
  waistCircumferenceCm String?

  // PE (Physical Examination) - จาก Visit
  alcohol           String?
  smoking           String?
  congenitalDisease String?
  drugUsage         String?
  hepatitisBVaccine String?
  fasting           String?
  presentIllness    String?
  pregnant          String?
  gestationalAge    String? // อายุครรภ์ (สัปดาห์)
  chemicalContact   String?
  bloodGroup        String?

  // Physical Examination (PE) - การตรวจร่างกายของหมอ
  teethGum             String? // ฟัน/เหงือก
  eyeEarThroatNose     String? // หู ตา คอ จมูก
  heartLungChestBreast String? // หัวใจ ปอด ทรวงอก เต้านม
  abdomenLiverSpleen   String? // ท้อง ตับ ม้าม
  extremitiesSkin      String? // แขน ขา ผิวหนัง
  thyroidGland         String? // ต่อมไทรอยด์
  lymphNode            String? // ต่อมน้ำเหลือง
  othersSpecified      String? // อื่นๆ ระบุ

  // ความเห็นของแพทย์ / Doctor Recommend
  otherResultsNote        String?  @db.Text // ผลตรวจอื่นๆ (free-text ใส่ตอนพิมพ์รายงาน)

  doctorRecommendIsNormal Boolean? // true = ปกติ, false = ผิดปกติ, null = ยังไม่เลือก
  doctorRecommendNote     String? // ระบุรายละเอียด (ถ้าผิดปกติ)
  docBy                   Int? // แพทย์ผู้ลงผล/ลงนาม (User id)
  docAt                   DateTime? // วันที่/เวลาที่แพทย์ลงนาม

  // อาการตามระบบ (กติ - ระบุก่อนผลตรวจ ตามใบ PE)
  // 1. หลัก: ปกติ | มี (ไม่มีอาการ / มีอาการ)
  conditionMain         String? // "ปกติ" = ไม่มีอาการ, "มี" = มีอาการ (ให้ระบุด้านล่าง)
  // 2–8. แต่ละระบบเก็บเป็น string รายการที่เลือก (คั่นด้วย comma หรือตามที่ frontend ส่ง)
  nervousSystem         String? // ระบบประสาท: เช่น "ปวดศีรษะ, หน้ามืด, ชาปลายมือปลายเท้า"
  respiratorySystem     String? // ระบบทางเดินหายใจ: เช่น "หวัดไข้, ไอเรื้อรัง, หอบ"
  musculoskeletalSystem String? // ระบบกระดูกและกล้ามเนื้อ: เช่น "ปวดคอ, ปวดหลัง"
  digestiveSystem       String? // ระบบทางเดินอาหาร: เช่น "ปวดท้อง, ท้องผูก"
  skinSystem            String? // ระบบผิวหนัง: เช่น "ผื่นคัน, ผื่นแดงอักเสบ"
  hearingSystem         String? // ระบบการได้ยิน: เช่น "หูอื้อ, หูตึง"
  visionSystem          String? // ระบบสายตา: เช่น "ปวดตา, มองไม่ชัด"
  symptomAdditionalInfo String? // 9. ข้อมูลเพิ่มเติม (free text)

  // Clinical Notes (จาก Visit - สำหรับ Clinic ในอนาคต)
  cc               String? // Chief Complaint
  hpi              String? // History of Present Illness
  pmh              String? // Past Medical History
  dxText           String? // Diagnosis
  ga               String? // GA (Gestational Age)
  pe               String? // Physical Examination (Clinical)
  doctorAdvice     String? // Doctor Advice
  doctorNote       String? // Doctor Note
  customFields     Json? // Custom fields (JSON)
  chart            Json? // Chart data (JSON)
  // Assessment (จาก Visit - สำหรับ Clinic ในอนาคต)
  painVas          Decimal?  @db.Decimal(3, 1)
  painType         String?
  painLocation     String?
  swellingLevel    String?
  swellingType     String?
  swellingLocation String?
  // Medical Certificate (จาก Visit - สำหรับ Clinic ในอนาคต)
  mcNotRest        Boolean?
  mcRestFrom       DateTime?
  mcRestTo         DateTime?
  mcCanFly         Boolean?

  DateReg   Int
  branchId  Int?
  createdBy Int?
  updatedBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Relations
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientCNGroup    CNGroupMembership? @relation(fields: [patientCNGroupId], references: [id], onDelete: SetNull)
  patientMembership PatientMembership? @relation(fields: [patientMembershipId], references: [id], onDelete: SetNull)
  branch            Branch?            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdByUser     User?              @relation("HealthRecordCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser     User?              @relation("HealthRecordUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  docByUser         User?              @relation("HealthRecordDocBy", fields: [docBy], references: [id], onDelete: SetNull)
  peQcResult        PeQcResult?        @relation("HealthRecordQcResult")

  @@unique([patientId, patientCNGroupId, DateReg]) // 1 ใบ PE ต่อปีต่อ CNGroup (สำหรับ Checkup)
  @@unique([patientId, patientMembershipId, DateReg]) // 1 ใบ PE ต่อปีต่อ PatientMembership (สำหรับ Clinic)
  @@index([patientId])
  @@index([patientCNGroupId])
  @@index([patientMembershipId])
  @@index([DateReg])
  @@index([patientId, DateReg])
  @@index([patientCNGroupId, DateReg])
  @@index([patientMembershipId, DateReg])
  @@index([branchId])
  @@index([createdBy])
  @@index([updatedBy])
}

// ==========================================
// OldHealthRecord — ข้อมูลผลตรวจเก่าที่ import จาก Excel
// ใช้แสดงใน PE Form เป็นข้อมูลอ้างอิงปีก่อนหน้า
// ไม่เกี่ยวข้องกับ PatientExaminationItem / ExaminationResult
// ==========================================
model OldHealthRecord {
  id               String  @id @default(cuid())
  patientId        Int
  patientCNGroupId String? // link กับ CNGroupMembership ที่ import มา
  DateReg          Int // ปี พ.ศ. เช่น 2566

  // Vitals
  height      String?
  weight      String?
  systolicBp  String?
  diastolicBp String?
  pulse       String?
  bloodGroup  String?

  // ประวัติสุขภาพ
  congenitalDisease String?
  drugUsage         String?
  hepatitisBVaccine String?
  alcohol           String?
  smoking           String?
  fasting           String?
  presentIllness    String?
  chemicalContact   String?

  // ผลแล็บ
  cbc          String?
  ua           String?
  sgot         String?
  sgpt         String?
  alp          String?
  bun          String?
  creatinine   String?
  cholesterol  String?
  triglyceride String?
  hdl          String?
  ldl          String?
  fbs          String?
  hbsag        String?
  hbsab        String?
  xray         String?
  ekg          String?

  createdBy Int?
  createdAt DateTime @default(now())

  patient        Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientCNGroup CNGroupMembership? @relation(fields: [patientCNGroupId], references: [id], onDelete: SetNull)
  createdByUser  User?              @relation("OldHealthRecordCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([patientId, patientCNGroupId, DateReg])
  @@index([patientId])
  @@index([patientCNGroupId])
  @@index([DateReg])
}

// ผลการ QC ต่อ 1 ใบ PE (HealthRecord) — ตรวจคุณภาพข้อมูล field-level
model PeQcResult {
  id             String   @id @default(uuid())
  healthRecordId String   @unique
  qcBy           Int
  qcAt           DateTime @default(now())
  result         String // 'pass' | 'fail'
  errorsJson     Json? // {"failed": {fieldKey: note}, "passed": [fieldKey, ...]}
  note           String? // หมายเหตุรวม (Overall Note)
  pointsAwarded  Int?     @default(0)

  healthRecord HealthRecord @relation("HealthRecordQcResult", fields: [healthRecordId], references: [id], onDelete: Cascade)
  qcByUser     User         @relation("PeQcResultQcBy", fields: [qcBy], references: [id], onDelete: Restrict)

  @@index([healthRecordId])
  @@index([qcBy])
  @@index([qcAt])
  @@index([result])
}

// ระบบเครื่องมือตรวจ (Equipment)
model Equipment {
  id          String   @id @default(uuid())
  name        String // ชื่ออุปกรณ์ เช่น "เครื่องตรวจหู", "เครื่องตรวจตา"
  brand       String? // ยี่ห้อ
  model       String? // รุ่น
  serialNo    String? // Serial Number
  equipmentNo String? // หมายเลขเครื่อง
  type        String? // ประเภท (EAR, EYE, etc.)
  note        String? // หมายเหตุ
  isActive    Boolean  @default(true)
  createdBy   Int?
  updatedBy   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  // Relations
  createdByUser       User?                @relation("EquipmentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser       User?                @relation("EquipmentUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  earExaminations     EarExamination[]
  eyeExaminations     EyeExamination[]
  muscleExaminations  MuscleExamination[]
  lungExaminations    LungExamination[]
  bmdExaminations     BmdExamination[]
  equipmentToStations EquipmentToStation[]

  @@index([isActive])
  @@index([type])
  @@index([createdBy])
  @@index([updatedBy])
}

// ระบบเชื่อมโยงอุปกรณ์กับจุดตรวจ
model EquipmentToStation {
  id          String   @id @default(uuid())
  equipmentId String
  stationId   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   Int?
  updatedBy   Int?

  // Relations
  equipment     Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  station       Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)
  createdByUser User?     @relation("EquipmentToStationCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?     @relation("EquipmentToStationUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([equipmentId, stationId])
  @@index([equipmentId])
  @@index([stationId])
  @@index([createdBy])
  @@index([updatedBy])
}

// ระบบการตรวจหู
model EarExamination {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  createdBy Int?
  updatedBy Int?
  updatedAt DateTime @updatedAt

  // ข้อมูลการตรวจ
  examinationNumber Int // ครั้งที่ตรวจ (auto-increment ต่อผู้ป่วยใน CNGroup เดียวกัน)

  // Foreign Key ไปยัง Patient และ Membership
  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // สำหรับ Checkup
  patientCNGroupId String? // ID ของ CNGroupMembership
  patientCNGroup   CNGroupMembership? @relation("EarExaminationCNGroup", fields: [patientCNGroupId], references: [id], onDelete: SetNull)

  // สำหรับ Clinic (เพิ่มใหม่)
  patientMembershipId String? // ID ของ PatientMembership
  patientMembership   PatientMembership? @relation("EarExaminationPatientMembership", fields: [patientMembershipId], references: [id], onDelete: SetNull)

  // เก็บ CN และ HN แยกกัน (backward compatibility)
  cn String? // หมายเลข CN (สำหรับ Checkup) - เปลี่ยนเป็น optional
  hn String? // หมายเลข HN (สำหรับ Clinic) - เพิ่มใหม่

  // เครื่องมือที่ใช้
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  // ข้อมูลการตรวจหู - หูซ้าย
  earL500  String? // 500Hz
  earL1000 String? // 1000Hz
  earL2000 String? // 2000Hz
  earL3000 String? // 3000Hz
  earL4000 String? // 4000Hz
  earL6000 String? // 6000Hz
  earL8000 String? // 8000Hz
  earLAvg  String? // ค่าเฉลี่ยความถี่ต่ำ (500+1000+2000)/3
  earLAvg2 String? // ค่าเฉลี่ยความถี่สูง (3000+4000+6000+8000)/4
  earLNote String? // หมายเหตุหูซ้าย (กรณีตรวจไม่ได้)

  // ข้อมูลการตรวจหู - หูขวา
  earR500  String? // 500Hz
  earR1000 String? // 1000Hz
  earR2000 String? // 2000Hz
  earR3000 String? // 3000Hz
  earR4000 String? // 4000Hz
  earR6000 String? // 6000Hz
  earR8000 String? // 8000Hz
  earRAvg  String? // ค่าเฉลี่ยความถี่ต่ำ (500+1000+2000)/3
  earRAvg2 String? // ค่าเฉลี่ยความถี่สูง (3000+4000+6000+8000)/4
  earRNote String? // หมายเหตุหูขวา (กรณีตรวจไม่ได้)

  // ผลการประเมิน
  assessmentLeftEar      String? // ปกติ/เฝ้าระวัง/ผิดปกติ
  assessmentRightEar     String? // ปกติ/เฝ้าระวัง/ผิดปกติ
  assessmentLeftEarLow   String? // ประเมินความถี่ต่ำ
  assessmentLeftEarHigh  String? // ประเมินความถี่สูง
  assessmentRightEarLow  String? // ประเมินความถี่ต่ำ
  assessmentRightEarHigh String? // ประเมินความถี่สูง

  // ข้อมูลเพิ่มเติม
  earComment                      String? // ปัญหาการได้ยิน (มี/ไม่มี)
  earComment_Specify              String? // รายละเอียดปัญหาการได้ยิน
  Shift_Work                      String? // เข้ากะออกกะ
  Loudness_in_12hours             String? // การสัมผัสเสียงดังใน 12ชมที่ผ่านมา (มี/ไม่มี)
  Loudness_in_12hours_AmountTime  String? // จำนวนชั่วโมงที่สัมผัสเสียงดังใน 12ชม
  Guard                           String? // ใช้อุปกรณ์ป้องกัน (มี/ไม่มี)
  Guard_Specify                   String? // อุปกรณ์ป้องกันที่ใช้
  earResult                       String? // ผลการตรวจหู
  Loudness_in_Workarea            String? // เสียงกระแทกในพื้นที่ทำงาน (มี/ไม่มี)
  Loudness_in_Workarea_AmountTime String? // จำนวนชั่วโมงที่มีเสียงกระแทก
  Disease_or_Accident_Ear         String? // ประวัติโรค/อุบัติเหตุเกี่ยวกับหู (มี/ไม่มี)
  Disease_or_Accident_Ear_Specify String? // รายละเอียดโรค/อุบัติเหตุเกี่ยวกับหู
  Drug_Ear                        String? // ประวัติการได้รับยา (มี/ไม่มี)
  Drug_Ear_Specify                String? // รายละเอียดยาที่ส่งผลต่อหู

  earInterpretationResult String? // คำแปลผลรวมทั้งสองหู + คำแนะนำ เช่น "หูซ้ายปกติ หูขวาผิดปกติที่ความถี่สูง ควรสวมอุปกรณ์ป้องกันเสียง"

  recordBy  String? // ชื่อเต็มของคนบันทึก (คำนำหน้า + ชื่อ + นามสกุล)
  isDeleted Boolean @default(false) // สำหรับ soft delete

  // Relations
  createdByUser User? @relation("EarExaminationCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("EarExaminationUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  // Unique constraints: แยกตาม Checkup และ Clinic
  @@unique([cn, patientCNGroupId, examinationNumber]) // สำหรับ Checkup
  @@unique([hn, patientMembershipId, examinationNumber]) // สำหรับ Clinic (เพิ่มใหม่)
  @@index([patientId])
  @@index([patientCNGroupId])
  @@index([patientMembershipId]) // เพิ่มใหม่
  @@index([cn])
  @@index([hn]) // เพิ่มใหม่
  @@index([equipmentId])
  @@index([createdBy])
  @@index([createdAt])
  @@index([isDeleted])
}

// ==========================================
// ExaminationResult - Header ผลการตรวจ
// ==========================================
model ExaminationResult {
  id String @id @default(cuid())

  patientExaminationItemId String                 @unique // 1:1 กับ PatientExaminationItem
  patientExaminationItem   PatientExaminationItem @relation(fields: [patientExaminationItemId], references: [id], onDelete: Cascade)

  examTypeId Int // snapshot จาก MedicalItem.examTypeId
  examType   ExamType @relation("ExaminationResultExamType", fields: [examTypeId], references: [id])

  status  ResultStatus @default(IN_PROGRESS)
  summary String? // สรุปผล เช่น ปกติ / เฝ้าระวัง / ผิดปกติ / แจ้งด่วน (EKG) หรือ free text (X-ray)
  note    String? // คำวินิจฉัย / หมายเหตุแพทย์

  recordedBy Int? // ใครบันทึก
  recordedAt DateTime? // บันทึกเมื่อไหร่

  // Relations (Detail Level)
  resultItems ResultItem[] @relation("ExaminationResultItems")

  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientExaminationItemId])
  @@index([examTypeId])
  @@index([branchId])
}

// ==========================================
// ResultItem - ผลการตรวจแต่ละ Parameter (Details)
// ==========================================
model ResultItem {
  id String @id @default(cuid())

  resultId String
  result   ExaminationResult @relation("ExaminationResultItems", fields: [resultId], references: [id], onDelete: Cascade)

  parameterTemplateId Int? // ผูกกับ ParameterTemplate (Optional)
  parameterTemplate   ParameterTemplate? @relation("ResultItemParameterTemplate", fields: [parameterTemplateId], references: [id], onDelete: SetNull)

  parameterName  String // "WBC", "RBC", "HGB" (จาก Template หรือกรอกเอง)
  value          String? // ค่าผลการตรวจ (5,200, 4.8, 15.0)
  unit           String? // "cells/μL" (Snapshot จาก Template)
  referenceRange String? // "4,000-11,000" (Snapshot จาก Template - ไม่เปลี่ยน)
  isAbnormal     Boolean? // คำนวณตอนบันทึก (Snapshot)
  flag           String? // key สำหรับดึงคำแปลผล (แผนกประมวลผล): null | 'LOW' | 'HIGH' | 'CRITICAL_LOW' | 'CRITICAL_HIGH' | 'BORDERLINE_LOW' | 'BORDERLINE_HIGH' | 'ABNORMAL'
  labFlag        String? // เฉพาะ Lab: 'LL' | 'L' | 'H' | 'HH' (ไม่เกี่ยวกับ flag/interpretation)
  interpretation String? // คำแปลผลจาก ParameterReferenceRange.interpretation[flag] (ปกติ/ผิดปกติ ฯลฯ)
  note           String? // หมายเหตุที่ผู้ลงผลกรอกต่อรายการนี้
  resultDetail   String? // รายงานเพิ่มเติม เช่น ชื่อเชื้อ เมื่อ value อยู่ใน detailTriggers
  parameterOrder Int? // ลำดับแสดงผล

  recordedBy     Int? // ใครลงผลที่พารามิเตอร์นี้ (User id)
  recordedAt     DateTime? // ลงผลเมื่อไหร่
  recordedByUser User?     @relation("ResultItemRecordedBy", fields: [recordedBy], references: [id], onDelete: SetNull)

  // สถานะผลตรวจ (รวม entry + approval)
  status ResultItemStatus @default(PENDING)

  // ผู้ยืนยันส่งอนุมัติ (เมื่อสถานะเป็น PENDING_APPROVAL)
  submittedBy     Int?
  submittedAt     DateTime?
  submittedByUser User?     @relation("ResultItemSubmittedBy", fields: [submittedBy], references: [id], onDelete: SetNull)

  // ผู้อนุมัติ (เมื่อสถานะเป็น APPROVED)
  approvedBy     Int?
  approvedAt     DateTime?
  approvedByUser User?     @relation("ResultItemApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  // Snapshot จากช่วงอ้างอิง (สำหรับ audit/report - ไม่เปลี่ยนแม้ว่าช่วงอ้างอิงจะเปลี่ยน)
  refLow    Float?
  refHigh   Float?
  refMethod String? // เช่น NGSP, IFCC
  refNote   String?
  metadata  Json? // เก็บข้อมูลอื่นๆ เช่น expectedValue, normalValues, sex, age ที่ใช้เลือกช่วง

  // สำหรับ Amended Flow (แก้ไขหลังอนุมัติ)
  isAmended   Boolean @default(false) // ผ่านการแก้ไขหลังอนุมัติแล้วหรือไม่
  amendReason String? // เหตุผลที่ขอแก้ไข (เก็บชั่วคราวจนกว่าจะอนุมัติใหม่)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  editLogs ResultItemEditLog[] @relation("ResultItemEditLogs")

  @@index([resultId, parameterName])
  @@index([resultId, parameterOrder])
  @@index([parameterTemplateId])
}

// ==========================================
// ResultItemEditLog - ประวัติการแก้ไขผล Lab (Audit Trail)
// ==========================================
model ResultItemEditLog {
  id           Int        @id @default(autoincrement())
  resultItemId String
  resultItem   ResultItem @relation("ResultItemEditLogs", fields: [resultItemId], references: [id], onDelete: Cascade)

  // ค่าก่อนแก้ไข
  oldValue   String?
  oldUnit    String?
  oldLabFlag String?
  oldNote    String?

  // ค่าหลังแก้ไข
  newValue   String?
  newUnit    String?
  newLabFlag String?
  newNote    String?

  // ผู้แก้ไข
  editedById Int
  editedBy   User @relation("ResultItemEditLogUser", fields: [editedById], references: [id], onDelete: Restrict)

  // เวลาและเหตุผล
  editedAt DateTime @default(now())
  reason   String? // เหตุผลการแก้ไข (ถ้ามี)

  @@index([resultItemId, editedAt])
  @@index([editedById])
  @@index([editedAt])
}

