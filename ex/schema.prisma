// ==========================================
// Document Job Management System
// ==========================================

enum DocumentJobEmployeeSource {
  SCAN // Added via direct barcode scan
  IMPORT // Imported from ScanLog
}

model DocumentJobType {
  id          String  @id @default(uuid())
  name        String  @unique // EKG, XRAY, SPIROMETRY
  description String?
  isActive    Boolean @default(true)

  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documentJobs DocumentJob[]

  createdBy User? @relation("DocumentJobTypeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("DocumentJobTypeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  defaultStationId Int
  defaultStation   Station @relation("StationToJobType", fields: [defaultStationId], references: [id], onDelete: Restrict)

  @@index([name])
  @@index([isActive])
}

model DocumentJob {
  id      String  @id @default(uuid())
  jobId   String? @unique
  jobName String?

  // Relations
  membershipLinks DocumentJobMembership[]

  // Dates
  jobDate      DateTime? // วันที่ตรวจ
  sendDate     DateTime? // วันที่ส่ง
  checkDate    DateTime? // วันที่ตรวจทาน
  documentDate DateTime? // วันที่สร้างเอกสาร
  receiveDate  DateTime? // วันที่รับผล

  // Personnel
  sender   String? // ผู้นำส่ง
  reviewer String? // ผู้ตรวจทาน
  approver String? // ผู้อนุมัติ
  receiver String? // ผู้รับ

  // Result Info
  badDocuments      String? // จำนวนเอกสารเสีย
  notes             String? // หมายเหตุ
  doctorName        String? // ชื่อแพทย์
  doctorCertificate String? // ใบอนุญาตประกอบโรคศิลปะ

  // Result Personnel
  resultSender   String?
  resultReviewer String?
  resultReceiver String?

  // System Info
  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documentJobTypeId String
  type              DocumentJobType @relation(fields: [documentJobTypeId], references: [id], onDelete: Restrict)

  // Relations to User and CNGroup
  createdBy User?    @relation("DocumentJobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?    @relation("DocumentJobUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  cnGroupId String?
  cnGroup   CNGroup? @relation("DocumentJobToCNGroup", fields: [cnGroupId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([jobDate])
  @@index([createdById])
  @@index([cnGroupId])
  @@index([documentJobTypeId])
}

model DocumentJobMembership {
  id            String                    @id @default(uuid())
  documentJobId String
  membershipId  String // CNGroupMembership ID
  addedAt       DateTime                  @default(now())
  addedById     Int?
  source        DocumentJobEmployeeSource @default(SCAN)

  isDeleted   Boolean           @default(false)
  documentJob DocumentJob       @relation(fields: [documentJobId], references: [id], onDelete: Cascade)
  membership  CNGroupMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  addedBy     User?             @relation("DocumentJobMembershipAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([documentJobId, membershipId])
  @@index([documentJobId])
  @@index([membershipId])
  @@index([addedById])
  @@index([isDeleted])
  @@index([source])
}

// ==========================================
// Role & Permission System (Database RBAC)
// ==========================================

// Role Table (แทน RoleEnum - จัดการจาก DB ได้)
model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique // ADMIN, STAFF, GUEST, DOCTOR, PARTTIME, CUSTOMER, LAB, MEDTECH, PROCESS, QC
  name        String // ชื่อแสดง เช่น "ผู้ดูแลระบบ", "พนักงาน"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  users           User[]
}

// Permission Table (Resource:Action หรือ menu key - sync กับ permissions.js)
model Permission {
  id          Int      @id @default(autoincrement())
  key         String   @unique // e.g. "cngroup:create", "patient:read", "menu:settings:users"
  description String?
  type        String? // "api" | "menu" (optional)
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

// RolePermission (Many-to-Many: Role <-> Permission)
model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// ==========================================
// Customer Rating System
// ==========================================
model CustomerRating {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  rating    Int // 1-5
  comment   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation("CustomerRatingUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([rating])
  @@index([isActive])
  @@index([createdAt])
}

// Snapshot ของรายการตรวจที่สั่งไว้สำหรับ CNGroup (ไม่เปลี่ยนแปลง)
model CNGroupExpectedItem {
  id            String   @id @default(cuid())
  cnGroupId     String
  medicalItemId String
  quantity      Int      @default(1) // จำนวนที่สั่งตรวจ
  note          String? // หมายเหตุ (ถ้ามี)
  createdBy     Int? // ผู้สร้าง (snapshot ไม่มี updatedBy/updatedAt)
  createdAt     DateTime @default(now())

  // Relations
  cnGroup       CNGroup     @relation(fields: [cnGroupId], references: [id], onDelete: Cascade)
  medicalItem   MedicalItem @relation(fields: [medicalItemId], references: [id], onDelete: Restrict)
  createdByUser User?       @relation("CNGroupExpectedItemCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([cnGroupId, medicalItemId]) // ไม่ให้มีรายการซ้ำ
  @@index([cnGroupId])
  @@index([medicalItemId])
  @@index([createdBy])
}

// ==========================================
// Referral - ใบสั่งตัว (ส่งตัวไปตรวจที่สาขาอื่น)
// ==========================================
model Referral {
  id String @id @default(cuid())

  // เชื่อมกับ Registration และ PatientExaminationItem
  fromRegistrationId String // Registration ที่ส่งตัว (สาขา A)
  fromBranchId       Int // สาขาที่ส่งตัว
  toBranchId         Int // สาขาที่ส่งไป (คลินิกหลัก)

  patientExaminationItemId String // รายการตรวจที่ต้องส่งตัว
  patientId                Int
  medicalItemId            String

  // ข้อมูลการส่งตัว
  referralDate DateTime @default(now()) // วันที่ส่งตัว
  reason       String? // เหตุผล
  note         String? // หมายเหตุ

  // Status
  status ReferralStatus @default(PENDING) // PENDING | IN_PROGRESS | COMPLETED | CANCELLED

  // ข้อมูลผู้ออกใบ
  issuedBy   Int? // ผู้ส่งตัว
  receivedBy Int? // ผู้รับตัว

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  fromRegistration       Registration           @relation("ReferralFromRegistration", fields: [fromRegistrationId], references: [id], onDelete: Cascade)
  fromBranch             Branch                 @relation("ReferralFromBranch", fields: [fromBranchId], references: [id], onDelete: Cascade)
  toBranch               Branch                 @relation("ReferralToBranch", fields: [toBranchId], references: [id], onDelete: Cascade)
  patientExaminationItem PatientExaminationItem @relation(fields: [patientExaminationItemId], references: [id], onDelete: Cascade)
  patient                Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicalItem            MedicalItem            @relation(fields: [medicalItemId], references: [id], onDelete: Restrict)
  issuedByUser           User?                  @relation("ReferralIssuedBy", fields: [issuedBy], references: [id], onDelete: SetNull)
  receivedByUser         User?                  @relation("ReferralReceivedBy", fields: [receivedBy], references: [id], onDelete: SetNull)

  @@index([fromRegistrationId])
  @@index([patientExaminationItemId])
  @@index([patientId])
  @@index([medicalItemId])
  @@index([status])
  @@index([referralDate])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([issuedBy])
  @@index([receivedBy])
}

// ==========================================
// PatientLog - ประวัติการแก้ไข Patient
// ==========================================
model PatientLog {
  id String @id @default(cuid())

  patientId Int
  action    String // 'UPDATE', 'CREATE', 'DELETE'

  // สำหรับการแก้ไขหลาย fields ในครั้งเดียว
  // ใช้ JSON เก็บ array ของ { fieldName, oldValue, newValue }
  // เช่น [{"fieldName": "first_name", "oldValue": "สมชาย", "newValue": "สมศักดิ์"}, {"fieldName": "citizenId", "oldValue": null, "newValue": "1234567890123"}]
  changes Json? // Array of { fieldName, oldValue, newValue }

  description String? // คำอธิบายการเปลี่ยนแปลง

  changedBy Int? // ผู้แก้ไข
  changedAt DateTime @default(now())

  // Relations
  patient       Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  changedByUser User?   @relation("PatientLogChangedBy", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([action])
  @@index([changedBy])
  @@index([changedAt])
  @@index([patientId, changedAt])
}

// ==========================================
// WORKFLOW TRACKING MODELS (New)
// ==========================================

// แม่แบบ Task Template (Blueprint)
model TaskTemplate {
  id          String  @id @default(cuid())
  name        String // ชื่อแม่แบบ เช่น "ชุดตรวจ Lab + X-ray"
  description String? // คำอธิบาย
  isActive    Boolean @default(true)

  // เก็บขั้นตอนมาตรฐาน เป็น JSON array
  // รูปแบบ: [
  //   {"name": "ลงทะเบียน", "order": 1, "leadTimeDays": 0, "dependsOnOrder": null},
  //   {"name": "QC", "order": 2, "leadTimeDays": 2, "dependsOnOrder": 1},
  //   {"name": "ออกผล", "order": 3, "leadTimeDays": 1, "dependsOnOrder": 2}
  // ]
  steps Json

  createdBy Int?
  updatedBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  createdByUser User?     @relation("TaskTemplateCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?     @relation("TaskTemplateUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  cnGroups      CNGroup[] @relation("CNGroupTaskTemplate")

  @@index([isActive])
  @@index([createdBy])
}

// งานจริงของแต่ละ CnGroup
model CnGroupTask {
  id             String            @id @default(cuid())
  cnGroupId      String // FK ไป CNGroup
  taskName       String // ชื่อขั้นตอน (เช่น "ลงทะเบียน", "QC", "ออกผล")
  status         CnGroupTaskStatus @default(TODO) // TODO, IN_PROGRESS, COMPLETE
  order          Int // ลำดับการแสดงผล (1, 2, 3...)
  dependsOnOrder Int? // ลำดับของงานที่ควรเสร็จก่อน (Soft Dependency)

  // Timeline
  plannedStartDate DateTime? // วันเริ่มต้นที่วางแผนไว้ (คำนวณจาก template)
  dueDate          DateTime? // กำหนดเสร็จงานย่อย (คำนวณจาก targetEndDate)
  startedAt        DateTime? // บันทึกเมื่อ status เป็น IN_PROGRESS
  completedAt      DateTime? // บันทึกเมื่อ status เป็น COMPLETE

  // Additional info
  phase        String? // หมวดหมู่/ขั้นตอนหลัก เช่น "ก่อนตรวจ", "วันตรวจ", "หลังตรวจ"
  remark       String? // บันทึกเพิ่มเติมกรณีงานติดขัด
  leadTimeDays Int? // เวลาที่ควรใช้ (วัน) - ก๊อปจาก template

  createdBy Int?
  updatedBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  cnGroup       CNGroup @relation(fields: [cnGroupId], references: [id], onDelete: Cascade)
  createdByUser User?   @relation("CnGroupTaskCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?   @relation("CnGroupTaskUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([cnGroupId])
  @@index([status])
  @@index([order])
  @@index([dueDate])
  @@index([cnGroupId, order])
  @@index([cnGroupId, status])
}

// ==========================================
// MEDICAL CERTIFICATE SYSTEM
// ==========================================

enum MedCertType {
  FIVE_DISEASE // ใบรับรองแพทย์ 5 โรค
  DRIVING // ใบอนุญาตขับรถ
  SOR11 // สน.11
  CONFINED_SPACE // ที่อับอากาศ
  HIGH_PLACE // ที่สูง
  SORCHOR8 // สธช.8
  MEDICAL_SERVICE // การให้บริการทางการแพทย์
  SICK_LEAVE // การป่วย
}

enum MedCertStatus {
  DRAFT
  ISSUED
  VOID
}

enum MedCertLanguage {
  TH
  EN
}

enum MedCertAction {
  CREATED
  UPDATED
  ISSUED
  PRINTED
  VOIDED
}

model MedicalCertificate {
  id         String  @id @default(cuid())
  certNumber String? @unique // รูปแบบ: MC-YYYY-NNNNN (set on ISSUED)

  type     MedCertType     @default(FIVE_DISEASE)
  status   MedCertStatus   @default(DRAFT)
  language MedCertLanguage @default(TH)

  // Patient snapshot (ณ วันออกใบ)
  patientId      Int
  patient        Patient @relation(fields: [patientId], references: [id])
  patientName    String
  patientHn      String
  patientAge     Int?
  patientAddress String? @db.Text
  citizenId      String?

  // ประวัติสุขภาพ ส่วนที่ 1 (snapshot ณ วันออกใบ)
  underlyingDiseaseHas  Boolean @default(false)
  underlyingDiseaseNote String?
  accidentSurgeryHas    Boolean @default(false)
  accidentSurgeryNote   String?
  hospitalizationHas    Boolean @default(false)
  hospitalizationNote   String?
  epilepsyHas           Boolean @default(false)
  epilepsyNote          String?
  otherHistoryHas       Boolean @default(false)
  otherHistory          String? @db.Text

  // Vitals snapshot จาก HealthRecord ล่าสุด
  weight    Decimal? @db.Decimal(5, 2)
  height    Decimal? @db.Decimal(5, 2)
  bpSys     Int?
  bpDia     Int?
  pulseRate Int?
  bmi       Decimal? @db.Decimal(4, 2)

  // Physical condition (ส่วนที่ 2)
  bodyConditionNormal Boolean?
  bodyConditionNote   String?

  // Disease conditions JSON array (ต่างกันตาม cert type)
  conditionDetails Json?

  // ตำแหน่ง/อาชีพ (สำหรับ สน.11 และ cert type ที่ต้องการ)
  occupation String?

  // สรุปของแพทย์
  doctorSummary String? @db.Text

  // Doctor snapshot
  issuedById       Int?
  issuedByUser     User?   @relation("MedCertIssuedBy", fields: [issuedById], references: [id])
  issuedByName     String?
  issuedByLicense  String?
  issuedByPosition String? // snapshot ตำแหน่งหน้าที่แพทย์

  examDate DateTime?

  // Registration reference (optional)
  registrationId String?
  registration   Registration? @relation(fields: [registrationId], references: [id])

  // SICK_LEAVE fields
  mcDiagnosis      String?   @db.Text
  mcRecommendation String?   @db.Text
  mcTreatFrom      DateTime?
  mcTreatTo        DateTime?
  mcVisitNote      String?   @db.Text
  mcVisitDate      DateTime?
  mcRestFrom       DateTime?
  mcRestTo         DateTime?
  mcCanFly         Boolean?

  // CONFINED_SPACE fields
  medicationHas     Boolean? // ประวัติการใช้ยาประจำ
  medicationNote    String? // ระบุชื่อยา
  smokingStatus     String? // 'NO' | 'YES'
  smokingNote       String? // จำนวน/ชนิดที่สูบ
  pulseRegular      Boolean? // ชีพจรสม่ำเสมอ (true=สม่ำเสมอ)
  workFitnessResult String? // 'FIT' | 'FIT_RESTRICTED' | 'UNFIT'
  workFitnessNote   String? // รายละเอียดข้อจำกัด / เหตุผล
  healthQuestions   Json? // { q1-q22: bool, q21_lastPeriod: string, additionalDetail: string }

  // Audit
  branchId   Int?
  branch     Branch?   @relation(fields: [branchId], references: [id])
  isVoid     Boolean   @default(false)
  voidedAt   DateTime?
  voidedById Int?
  createdBy  Int?
  updatedBy  Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  auditLogs MedCertAuditLog[]

  @@index([patientId])
  @@index([status])
  @@index([type])
  @@index([branchId])
  @@index([createdAt])
}

model MedCertNumberSequence {
  id        Int @id @default(autoincrement())
  year      Int @unique
  nextValue Int @default(1)
}

model MedCertAuditLog {
  id         Int                @id @default(autoincrement())
  certId     String
  cert       MedicalCertificate @relation(fields: [certId], references: [id])
  certNumber String?
  action     MedCertAction
  userId     Int?
  userName   String?
  patientId  Int?
  patientHn  String?
  detail     Json?
  createdAt  DateTime           @default(now())

  @@index([certId])
  @@index([action])
  @@index([createdAt])
}
