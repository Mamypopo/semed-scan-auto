  updatedAt DateTime @updatedAt
}

model LabExamination {
  id                   String               @id @default(cuid())
  patientId            Int
  registrationId       String?
  labNumber            String               @unique
  specimenTypeId       Int?
  collectedAt          DateTime?
  receivedAt           DateTime?
  receivedBy           Int?
  ward                 String?
  status               LabExaminationStatus @default(WAITING)
  labBy                Int?
  labAt                DateTime?
  approvedBy           Int?
  approvedAt           DateTime?
  currentReportVersion Int                  @default(0) // เพิ่มทุกครั้งที่ approve หรือ quick-edit
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  // Relations
  patient        Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  registration   Registration?            @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  specimenType   SpecimenType?            @relation(fields: [specimenTypeId], references: [id], onDelete: SetNull)
  receivedByUser User?                    @relation("LabExaminationReceivedBy", fields: [receivedBy], references: [id], onDelete: SetNull)
  labByUser      User?                    @relation("LabExaminationLabBy", fields: [labBy], references: [id], onDelete: SetNull)
  approvedByUser User?                    @relation("LabExaminationApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  patientItems   PatientExaminationItem[]
  auditLogs      LabExaminationAuditLog[]
  reportVersions LabReportVersion[]

  @@index([patientId])
  @@index([registrationId])
  @@index([specimenTypeId])
  @@index([status])
  @@index([receivedAt])
}

model LabExaminationAuditLog {
  id               String   @id @default(cuid())
  labExaminationId String
  labNumber        String?
  action           String
  userId           Int?
  userName         String?
  patientId        Int? // Patient ID สำหรับค้นหา
  patientHn        String? // Snapshot HN (สำหรับค้นหา + แสดง)
  patientName      String? // Snapshot ชื่อผู้ป่วย (คำนำหน้า ชื่อ นามสกุล - ไม่รวม HN)
  detail           Json?
  createdAt        DateTime @default(now())

  // Relations
  labExamination LabExamination @relation(fields: [labExaminationId], references: [id], onDelete: Cascade)
  user           User?          @relation("LabExaminationAuditUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([labExaminationId])
  @@index([userId])
  @@index([userName])
  @@index([patientId])
  @@index([patientHn])
  @@index([patientName])
  @@index([createdAt])
}

model LabReportVersion {
