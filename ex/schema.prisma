  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([entityType])
  @@index([entityId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([userId])
  @@index([branchId])
  @@index([createdAt])
  @@index([entityType, createdAt])
