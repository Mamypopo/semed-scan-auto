// ระบบการตรวจตา
model EyeExamination {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  // ข้อมูลการตรวจ
  examinationNumber Int // ครั้งที่ตรวจ (auto-increment ต่อผู้ป่วยใน CNGroup เดียวกัน)

  // Foreign Key ไปยัง Patient และ Membership
  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // สำหรับ Checkup
  patientCNGroupId String? // ID ของ CNGroupMembership
  patientCNGroup   CNGroupMembership? @relation("EyeExaminationCNGroup", fields: [patientCNGroupId], references: [id], onDelete: SetNull)

  // สำหรับ Clinic (เพิ่มใหม่)
  patientMembershipId String? // ID ของ PatientMembership
  patientMembership   PatientMembership? @relation("EyeExaminationPatientMembership", fields: [patientMembershipId], references: [id], onDelete: SetNull)

  // เก็บ CN และ HN แยกกัน (backward compatibility)
  cn String? // หมายเลข CN (สำหรับ Checkup) - เปลี่ยนเป็น optional
  hn String? // หมายเลข HN (สำหรับ Clinic) - เพิ่มใหม่

  // เครื่องมือที่ใช้
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  // ข้อมูลการตรวจตา
  WorkGroup            String? // กลุ่มการตรวจที่เลือก (1, 2, 3, 4, 5, 6)
  OccVision_Problem    String? // มี/ไม่มีปัญหาด้านสายตา (เก็บเป็น comma-separated string)
  OccVision_EyeDisease String? // โรคเกี่ยวกับสายตา (เก็บเป็น JSON array)
  OccVision_Modify     String? // การแก้ไขปัญหา (1ไม่ได้แก้ไข, 2แว่นตา, 3คอนแทค)
  OccVision_Comment    String? // หมายเหตุการแก้ไข 
  OccVision_Result     String? // ผลสรุป
  OccVision_TestNote   String? // หมายเหตุการตรวจ

  // Slide 2: มองไกล
  Far_Score  String?
  Far_Result String?
  Far_Remark String?
  FarComment String?

  // Slide 5: มองภาพ3มิติ
  StereoDepth_Score  String?
  StereoDepth_Result String?
  StereoDepth_Remark String?

  // Slide 6: การแยกสี เครื่อง
  Color_Score  String?
  Color_Result String?
  Color_Remark String?

  // Slide 6 ( Chart )
  Color_ScoreChart  String?
  Color_ResultChart String?

  // Slide 7: การมองแนวดิ่ง
  VerticalFar_Score  String?
  VerticalFar_Result String?
  VerticalFar_Remark String?

  // Slide 8: แนวราบไกล
  LateralFar_Score  String?
  LateralFar_Result String?
  LateralFar_Remark String?

  // Slide 9: มองระยะใกล้
  Near_Score  String?
  Near_Result String?
  Near_Remark String?
  NearComment String?

  // Slide 12: ระนาบใกล้
  LateralNear_Score  String?
  LateralNear_Result String?
  LateralNear_Remark String?

  // Visual Field (ลานสายตา) - เฉพาะกลุ่ม 3
  VisualField_Left   String? // ลานสายตาซ้าย (85°, 70°, 55°, Nasal 45°)
  VisualField_Right  String? // ลานสายตาขวา (85°, 70°, 55°, Nasal 45°)
  VisualField_Result String? // ผลลัพธ์ลานสายตา (ปกติ, ผิดปกติ)
  VisualField_Remark String? // หมายเหตุลานสายตา

  // Slide 1: Demonstration - การมองเห็น 2 ตา
  Demonstration_score  String? // สีของวงกลมที่ปลายถนน (สีน้ำตาล, สีเขียว, สีแดง)
  Demonstration_Result String? // ผลการตรวจสีของวงกลม (ปกติ, ตาขวาผิดปกติ, ตาซ้ายผิดปกติ)

  // จำนวนกล่องสี่เหลี่ยม
  BoxCount_score  String? // จำนวนกล่องสี่เหลี่ยม (3, 2)
  BoxCount_Result String? // ผลการตรวจจำนวนกล่อง (ปกติ, เห็นแดงตาซ้ายผิดปกติ, เห็นน้ำเงินตาขวาผิดปกติ)

  VAFar_Score  String? // ค่าสายตาระยะไกล เช่น "20/30" (คำนวณจาก Far_Score)
  VANear_Score String? // ค่าสายตาระยะใกล้ เช่น "20/30" (คำนวณจาก Near_Score)
  VA_Result    String? // ผลรวมค่าสายตา

  OccVision_Vision String? // คำแปลผลรวมทั้งหมด เช่น "ปกติ" หรือ "การมองเห็นระยะไกล ตาบอดสี มีความผิดปกติ ควรสวมแว่นสายตา..."

  recordBy  String? // ชื่อเต็มของคนบันทึก (คำนำหน้า + ชื่อ + นามสกุล)
  isDeleted Boolean @default(false) // สำหรับ soft delete

  // Relations
  createdByUser User? @relation("EyeExaminationCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("EyeExaminationUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([cn, patientCNGroupId, examinationNumber]) // ตรวจสอบไม่ให้ซ้ำ
  @@index([patientId])
  @@index([patientCNGroupId])
  @@index([cn])
  @@index([equipmentId])
  @@index([createdBy])
  @@index([createdAt])
  @@index([isDeleted])
}

// ระบบการตรวจกล้ามเนื้อ
model MuscleExamination {
